fn somar (a:f32,b:f32){
    let soma:f32 = a+b;
    println!("Resultado {}",soma);
}

fn subtrair(a:f32,b:f32){
    let sub:f32 = a-b;
    println!("Resultado {}",sub);
}

fn dividir (a:f32,b:f32){
    if  a>= b {
        let div:f32 = a/b; 
        println!("Resultado da divisao {}",div);       
    } else if b>a {
        let div:f32 = b/a;
        println!("Resultado da divisao {}",div);
    } else if a== 0.0 || b== 0.0 {
        println!("Divisao por zero");
    }
}

fn multiplicar (a:f32,b:f32){
    let mult:f32 = a*b;
    println!("Resultado {}",mult);
}


